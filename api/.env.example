# =========================
# Cloud AI — optional
# =========================
AI_PROVIDER=groq
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=openai/gpt-oss-20b
AI_FALLBACK_MODELS=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=90

# Backward-compatible Groq secret when AI_API_KEY is blank.
GROQ_API_KEY=

# Set AI_PROVIDER=disabled for a completely local-only product.

# =========================
# Firebase / entitlements
# =========================
# JSON service-account credential kept only in the hosting environment.
FIREBASE_SERVICE_ACCOUNT=

# Optional owner/developer bypass. Leave blank in normal production.
DEVELOPER_EMAIL=

FREE_DAILY_CREDITS=5
GUEST_DAILY_CREDITS=1

# =========================
# Lemon Squeezy Plus
# =========================
LEMON_WEBHOOK_SECRET=

# REQUIRED before Plus checkout is enabled.
# Comma-separated monthly + annual variant IDs, e.g. 12345,67890
LEMON_PLUS_VARIANT_IDS=

# Keep false in production. Enable only for deliberate test-mode billing tests.
ALLOW_TEST_BILLING=false

# =========================
# Abuse / request controls
# =========================
RATE_LIMIT_REQUESTS=12
RATE_LIMIT_WINDOW_SECONDS=60
MAX_JSON_BODY_BYTES=32768

# Optional comma-separated additional browser origins.
# Production defaults already include 1into1.com and the existing Firebase preview origins.
ALLOWED_ORIGINS=

# Public health endpoint is minimal by default.
EXPOSE_HEALTH_DETAILS=false

# =========================
# Optional monitoring
# =========================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
