# Cloud AI is optional. Core prayer/Bible/journey features work locally.
# Default keeps backward compatibility with an existing GROQ_API_KEY.
AI_PROVIDER=groq

# Preferred generic key. If omitted for Groq, GROQ_API_KEY is used.
AI_API_KEY=

# Used by openai_compatible providers, e.g. https://api.example.com/v1
AI_BASE_URL=

# Preferred cloud model. For Groq, a current example is:
AI_MODEL=openai/gpt-oss-20b

# Optional comma-separated fallbacks.
AI_FALLBACK_MODELS=openai/gpt-oss-120b

# Optional request timeout.
AI_TIMEOUT_SECONDS=90

# Backward-compatible Groq secret:
GROQ_API_KEY=

# Set AI_PROVIDER=disabled to run the whole site local-only.

# Plus Ask Deeper abuse ceiling. Local prayer is not limited by this.
PLUS_DAILY_FAIR_USE_LIMIT=100
