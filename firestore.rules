rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPlus(userId) {
      return isOwner(userId)
        && get(/databases/$(database)/documents/users/$(userId)).data.isSubscribed == true;
    }

    function validAccountCreate() {
      return request.resource.data.keys().hasOnly([
          'email', 'displayName', 'credits', 'isSubscribed', 'createdAt', 'lastActive'
        ])
        && request.resource.data.isSubscribed == false
        && request.resource.data.credits == 5;
    }

    function validAccountUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['email', 'displayName', 'lastActive']);
    }

    function validEncryptedBackup() {
      return request.resource.data.keys().hasOnly([
          'version', 'algorithm', 'kdf', 'iterations',
          'salt', 'iv', 'chunkCount', 'updatedAt'
        ])
        && request.resource.data.version == 1
        && request.resource.data.algorithm == 'AES-GCM'
        && request.resource.data.kdf == 'PBKDF2-SHA256'
        && request.resource.data.iterations is int
        && request.resource.data.iterations >= 100000
        && request.resource.data.iterations <= 1000000
        && request.resource.data.salt is string
        && request.resource.data.salt.size() <= 64
        && request.resource.data.iv is string
        && request.resource.data.iv.size() <= 64
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount >= 1
        && request.resource.data.chunkCount <= 32;
    }

    function validEncryptedChunk() {
      return request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 250000;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validAccountCreate();
      allow update: if isOwner(userId) && validAccountUpdate();
      allow delete: if false;

      // Legacy plaintext cloud prayer storage is intentionally closed.
      // The current product journal is local-first; Plus backup is encrypted.
      match /saved_prayers/{prayerId} {
        allow read, write: if false;
      }

      match /encrypted_backups/{backupId} {
        // Owners retain read/delete access to their encrypted data for portability.
        // Creating or replacing a cross-device backup is a Plus entitlement.
        allow read, delete: if isOwner(userId);
        allow create, update: if isPlus(userId) && validEncryptedBackup();

        match /chunks/{chunkId} {
          allow read, delete: if isOwner(userId);
          allow create, update: if isPlus(userId) && validEncryptedChunk();
        }
      }
    }

    // Server-managed cloud quota collection. Client access is never allowed.
    match /guest_usage/{docId} {
      allow read, write: if false;
    }
  }
}
